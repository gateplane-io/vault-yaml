variable "mount" {
  description = "The mount configuration object for the Kubernetes secrets engine ([`vault_kubernetes_secret_backend`](https://registry.terraform.io/providers/hashicorp/vault/latest/docs/resources/kubernetes_secret_backend))."
  type = object({
    path     = string
    accessor = string
  })
}

variable "enable_conditional_roles" {
  description = "Enable or disable conditional access roles that require approval workflows."
  type        = bool
  default     = true
}

variable "name_template" {
  description = "Template for generating Kubernetes Service Account names."
  type        = string
  default     = "{{.DisplayName | replace \"_\" \"-\"  | replace \" \" \"\"}}-{{.RoleName | replace \"_\" \"-\"}}-{{unix_time}}s"
}

# ======

variable "role_directory" {
  description = "The directory path containing Kubernetes role definition YAML files."
  type        = string
}

variable "accesses" {
  description = "Map of access configurations for Kubernetes secrets engine, defining heterogeneous role bodies and their properties."
  type        = any
}

variable "name_prefix" {
  description = "Per-mount prefix applied to generated Kubernetes names."
  type        = string
  default     = ""
}

variable "policy_name_prefix" {
  description = "Prefix applied to generated Vault policy and conditional-access names. Defaults to name_prefix for direct submodule callers."
  type        = string
  default     = null
}

variable "kubernetes_labels" {
  description = "Labels added to Kubernetes objects generated by Vault."
  type        = map(string)
  default = {
    managed_by = "vault"
  }
}
